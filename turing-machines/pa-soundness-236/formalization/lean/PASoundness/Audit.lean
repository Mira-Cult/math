import Lean.Elab.Command

/-!
Reproducible transitive axiom audit for every theorem in this development,
including private proof helpers. This is an inspection command, not an axiom
or a replacement for kernel checking the declarations. A new custom axiom or
an admitted/native-decision theorem causes this file to fail elaboration.
-/
open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut count : Nat := 0
  let mut used : Array Name := #[]
  for (name, info) in env.constants.map₁.toList ++ env.constants.map₂.toList do
    let s := name.toString
    if s.startsWith "PASoundness." || s.startsWith "_private.PASoundness." then
      match info with
      | .axiomInfo _ => throwError "Custom axiom declared in the development: {name}"
      | .thmInfo _ =>
        count := count + 1
        for axiomName in (← collectAxioms name) do
          unless allowed.contains axiomName do
            throwError "Unexpected transitive axiom {axiomName} in {name}"
          if !used.contains axiomName then
            used := used.push axiomName
      | _ => pure ()
  if count < 100 then
    throwError "Audit imported too few theorem declarations: {count}"
  logInfo m!"Transitive axiom audit: {count} theorem declarations; allowed foundations used: {used}"

