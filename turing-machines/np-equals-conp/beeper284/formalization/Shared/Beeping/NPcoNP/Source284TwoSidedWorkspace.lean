import Shared.Beeping.NPcoNP.Source284CleanWorkspace
import Shared.Beeping.NPcoNP.Source284ScratchCounterClear

/-! A finite source table consumes a prepared token tape and clears workspace
on both sides of the payload. It preserves the entire arbitrary certificate
and the arbitrary input suffix beyond the cleared window. Token generation is
separate; this theorem does not yet implement a polynomial verifier compiler. -/
set_option maxRecDepth 4096
set_option maxHeartbeats 4000000
namespace Shared.Beeping.NPcoNP.Source284TwoSidedWorkspace

open Shared.Beeping.NPcoNP.Source284TableEncode
open Shared.Beeping.NPcoNP.Source284TableRun
open Shared.Beeping.NPcoNP.Source284HardwireTable (shiftConfig)
open Shared.Beeping.NPcoNP.Source284ScratchFlipReturn (run_add)
open Shared.Beeping.NPcoNP.Source284ScratchFlip (flipped)
open Shared.Beeping.NPcoNP.Source284UnaryPairScanner (pairTape)
open Shared.Beeping.NPcoNP.Source284CountedShift (counter)
open Shared.Beeping.NPcoNP.Source284TokenCounterLoop (consumeTime halves)

def handoff (continuation : Nat → Bool → Row) : Nat → Bool → Row :=
  Source284OrientationHandoff.table 0
    (Source284UnaryErase.table (Source284ScratchCounterClear.table continuation))

def table (continuation : Nat → Bool → Row) : Nat → Bool → Row :=
  Source284FlippedCounterSeed.table (Source284TokenCounterLoop.table (handoff continuation))

theorem handoff_closed (states : Nat) (continuation : Nat → Bool → Row)
    (hn : 0 < states) (hv : Closed states continuation) : Closed (25+states) (handoff continuation) := by
  have hc := Source284ScratchCounterClear.closed states continuation hn hv
  have he := Source284UnaryErase.closed (15+states) (Source284ScratchCounterClear.table continuation) (by omega) hc
  have ho := Source284OrientationHandoff.closed (7+(15+states)) 0
    (Source284UnaryErase.table (Source284ScratchCounterClear.table continuation)) (by omega) he
  have h : 3+(7+(15+states)) = 25+states := by omega
  rw [h] at ho
  exact ho

theorem closed (states : Nat) (continuation : Nat → Bool → Row)
    (hn : 0 < states) (hv : Closed states continuation) : Closed (73+states) (table continuation) := by
  have hh := handoff_closed states continuation hn hv
  have hl := Source284TokenCounterLoop.closed (25+states) (handoff continuation) (by omega) hh
  have hs := Source284FlippedCounterSeed.closed (32+(25+states))
    (Source284TokenCounterLoop.table (handoff continuation)) (by omega) hl
  have he : 16+(32+(25+states)) = 73+states := by omega
  rw [he] at hs
  exact hs

def workCost (m width : Nat) : Nat :=
  (4*width+14) + (consumeTime m 0 0 width + (2+((4*m+6)+(4*width+2*m+14))))

/-- Both cleared regions are generated by one fixed source program, for any
number of supplied tokens. Every transition before the continuation is paid. -/
theorem workspace_then (continuation : Nat → Bool → Row) (m : Nat) (w : List Bool)
    (certificate suffix fuel : Nat) :
    run (table continuation) ⟨pairTape (List.replicate m false) certificate,
      2*flipped w suffix,some 0⟩ (workCost m w.length+fuel) =
    shiftConfig 73 (run continuation
      ⟨4^(m+1)*certificate,2*flipped w (2^(m+1)*halves m (suffix/2)),some 0⟩ fuel) := by
  have ht : workCost m w.length+fuel = (4*w.length+14) +
      (consumeTime m 0 0 w.length + (2+((4*m+6)+((4*w.length+2*m+14)+fuel)))) := by
    simp [workCost]; omega
  rw [ht]
  unfold table
  rw [Source284FlippedCounterSeed.seed_then,run_add]
  have hc := Source284TokenCounterLoop.consume (handoff continuation) m 0 w 0 certificate (suffix/2)
  simp only [List.replicate_zero,List.nil_append,Nat.zero_add] at hc
  rw [hc]
  change shiftConfig 16 (run (Source284TokenCounterLoop.table (handoff continuation))
    (shiftConfig 32 ⟨pairTape (List.replicate m true) certificate,
      2*flipped w (counter m (halves m (suffix/2))),some 1⟩) _) = _
  rw [Source284TokenCounterContinue.relocated_run]
  change shiftConfig 16 (shiftConfig 32 (run
    (Source284OrientationHandoff.table 0
      (Source284UnaryErase.table (Source284ScratchCounterClear.table continuation)))
    ⟨pairTape (List.replicate m true) certificate,
      2*flipped w (counter m (halves m (suffix/2))),some (Source284OrientationHandoff.initialState false)⟩ _)) = _
  rw [Source284OrientationHandoff.then_run]
  simp only [Source284OrientationHandoff.normalized,Bool.false_eq_true,ite_false,Prod.fst,Prod.snd]
  have he := Source284UnaryErase.clear_then (Source284ScratchCounterClear.table continuation)
    (List.replicate m true) certificate (flipped w (counter m (halves m (suffix/2))))
    ((4*w.length+2*m+14)+fuel)
  simp only [List.length_replicate] at he
  rw [he,Source284ScratchCounterClear.clear_scratch_then]
  repeat rw [Source284SourceRelocation.shiftConfig_add]

theorem workCost_formula (m width : Nat) :
    workCost m width = 3*m*m + m*(4*width+31)+8*width+44 := by
  simp [workCost,Source284TokenCounterLoop.consumeTime_formula]
  ring

/-- The entire finite prefix runs under the executable numeric source encoding. -/
theorem source_workspace_then (states : Nat) (continuation : Nat → Bool → Row)
    (m : Nat) (w : List Bool) (certificate suffix fuel : Nat)
    (hn : 0 < states) (hv : Closed states continuation) :
    Source284Relative.run (encode (73+states) (table continuation) 1)
      (Source284Relative.initial (2*flipped w suffix)
        (pairTape (List.replicate m false) certificate)) (workCost m w.length+fuel) =
    Source284SourceRelocation.lift 73
      (Source284Relative.run (encode states continuation 1)
        ⟨4^(m+1)*certificate,2*flipped w (2^(m+1)*halves m (suffix/2)),active 0⟩ fuel) := by
  let start : Config := ⟨pairTape (List.replicate m false) certificate,2*flipped w suffix,some 0⟩
  have hi : Valid (73+states) start := by intro q hq; simp [start] at hq; subst q; omega
  have hr := run_toSource (73+states) (table continuation) 1 start (closed states continuation hn hv)
    hi (workCost m w.length+fuel)
  rw [workspace_then,← Source284SourceRelocation.lift_toSource] at hr
  let finish : Config := ⟨4^(m+1)*certificate,2*flipped w (2^(m+1)*halves m (suffix/2)),some 0⟩
  have hf : Valid states finish := by intro q hq; simp [finish] at hq; subst q; exact hn
  have hs := run_toSource states continuation 1 finish hv hf fuel
  rw [← hs] at hr
  exact hr

namespace Fixtures

def loop (_ : Nat) (b : Bool) : Row := ⟨b,false,some 0⟩
example : run (table loop) ⟨pairTape [] 7,2*flipped [] 5,some 0⟩ 44 =
    ⟨28,2*flipped [] 4,some 73⟩ := by decide +kernel
example : run (table loop) ⟨pairTape [false] 7,2*flipped [true] 5,some 0⟩ 90 =
    ⟨112,2*flipped [true] 4,some 73⟩ := by decide +kernel
end Fixtures

end Shared.Beeping.NPcoNP.Source284TwoSidedWorkspace
