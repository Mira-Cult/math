import Shared.Beeping.NPcoNP.Source284GapUnarySource
import Shared.Beeping.NPcoNP.Source284OffsetDecodedHandoff
import Shared.Beeping.NPcoNP.Source284CertificateProbeSource

/-! A dynamic witness-length guard initialized from the actual framed input.
The bound is generated by a fixed finite table, and its comparison rejects
malformed or overlong tagged certificates at every clock. The supplied
verifier continuation and its interface to canonical NP remain separate. -/
set_option maxRecDepth 4096
set_option maxHeartbeats 6000000
set_option autoImplicit false
namespace Shared.Beeping.NPcoNP.Source284DynamicGuardSource

open Shared.Beeping.NPcoNP.Source284TableEncode
open Shared.Beeping.NPcoNP.Source284TableRun
open Shared.Beeping.NPcoNP.Source284HardwireTable (shiftConfig)
open Shared.Beeping.NPcoNP.Source284UnaryPairScanner (pairTape)
open Shared.Beeping.NPcoNP.Source284Parser (encodeFrame)
open Shared.Beeping.NPcoNP.Source284SourceRelocation (lift lift_toSource)

def bound (k n : Nat) : Nat := Source284GapUnarySource.gap k n/2

def otherHalf (k : Nat) (w : List Bool) (suffix : Nat) : Nat :=
  Source284GapUnaryPrepare.retained (Source284GapUnarySource.gap k w.length)
    (Source284GapUnarySource.stream k w suffix)

/-- Actual initializers always take the odd-gap branch, so a continuation
can remove one known marker to recover the preserved input stream; it need
not guess the parity or inspect arbitrary suffix data. -/
theorem otherHalf_shape (k : Nat) (w : List Bool) (suffix : Nat) :
    otherHalf k w suffix = 2*Source284GapUnarySource.stream k w suffix+1 := by
  have h := Source284GapUnarySource.gap_odd k w.length
  simp [otherHalf,Source284GapUnaryPrepare.retained,show Source284GapUnarySource.gap k w.length%2 ≠ 0 by omega]

def states (n : Nat) : Nat := 3+Source284OffsetTagged.goodStates n+1

def description (k n : Nat) (verifier : Nat → Bool → Row) : Nat :=
  Source284GapUnarySource.description k (states n) (Source284OffsetTagged.table n verifier)

/-- Once initialization has paid its entire source clock, the exact
remaining run is the already-proved tagged cutoff table, including its
accepting state and every retained tape cell. -/
theorem source_after (k n : Nat) (verifier : Nat → Bool → Row)
    (w : List Bool) (certificate suffix fuel : Nat) (hn : 0 < n) (hv : Closed n verifier) :
    Source284Relative.run (description k n verifier)
      (Source284Relative.initial (encodeFrame w suffix) certificate)
      (Source284GapUnarySource.totalCost k w+fuel) =
    lift (707+317*k) (Source284Relative.run (Source284OffsetTagged.description n verifier)
      (Source284Relative.initial certificate
        (pairTape (List.replicate (bound k w.length) false) (otherHalf k w suffix))) fuel) := by
  have hc : Closed (states n) (Source284OffsetTagged.table n verifier) :=
    Source284OffsetTagged.table_closed n verifier hn hv
  let c : Config := ⟨pairTape (List.replicate (bound k w.length) false) (otherHalf k w suffix),
    certificate,some 0⟩
  have hvalid : Valid (states n) c := by
    intro q hq
    simp [c] at hq
    subst q
    simp [states,Source284OffsetTagged.goodStates,Source284OffsetTagged.rawStates,
      Source284PositiveTaggedCutoff.rawStates]
  have hr := run_toSource (states n) (Source284OffsetTagged.table n verifier) 1 c hc hvalid fuel
  change Source284Relative.run (Source284OffsetTagged.description n verifier)
    (Source284Relative.initial certificate
      (pairTape (List.replicate (bound k w.length) false) (otherHalf k w suffix))) fuel = _ at hr
  calc
    _ = toSource (shiftConfig (707+317*k) (run (Source284OffsetTagged.table n verifier) c fuel)) := by
      simpa [description,bound,otherHalf,c] using
        Source284GapUnarySource.source_then k (states n) (Source284OffsetTagged.table n verifier)
          w certificate suffix fuel (by simp [states]) hc
    _ = lift (707+317*k) (toSource (run (Source284OffsetTagged.table n verifier) c fuel)) :=
      (lift_toSource _ _).symm
    _ = _ := by rw [hr]

/-- Any certificate rejected by the dynamic tagged decoder can never
accept, even before preparation finishes, even if the supplied verifier
would accept immediately. -/
theorem rejected_certificate_never_accepts (k n : Nat) (verifier : Nat → Bool → Row)
    (w : List Bool) (certificate suffix : Nat) (hn : 0 < n) (hv : Closed n verifier)
    (hbad : Source284TaggedWitnessCodec.decode (bound k w.length) certificate = none) :
    ∀ clock, Source284Relative.accepts (description k n verifier)
      (encodeFrame w suffix) certificate clock = false := by
  apply Source284PositiveTaggedCutoff.never_of_after _ _ _ (Source284GapUnarySource.totalCost k w)
  intro extra
  have h := Source284OffsetTagged.decoded_none_never_accepts n verifier (bound k w.length)
    certificate (otherHalf k w suffix) hn hv hbad extra
  unfold Source284Relative.accepts at h ⊢
  rw [source_after k n verifier w certificate suffix extra hn hv]
  simp only [beq_eq_false_iff_ne] at h ⊢
  simp [Source284SourceRelocation.lift,h]

/-- The same all-clock safety holds on every raw numeric input, including
zero-length parsed inputs and noncanonical high input suffixes. -/
theorem rejected_raw_certificate_never_accepts (k n : Nat) (verifier : Nat → Bool → Row)
    (input certificate : Nat) (hn : 0 < n) (hv : Closed n verifier)
    (hbad : Source284TaggedWitnessCodec.decode (bound k (Source284Parser.length input)) certificate = none) :
    ∀ clock, Source284Relative.accepts (description k n verifier) input certificate clock = false := by
  obtain ⟨w,suffix,hframe⟩ := Source284Parser.encodeFrame_surjective input
  have hlen : Source284Parser.length input = w.length := by
    rw [← hframe]
    simp [Source284Parser.length,Source284Parser.parse_encodeFrame]
  have hbad' : Source284TaggedWitnessCodec.decode (bound k w.length) certificate = none := by
    simpa [hlen] using hbad
  have h := rejected_certificate_never_accepts k n verifier w certificate suffix hn hv hbad'
  simpa [hframe] using h

theorem malformed_tag_never_accepts (k n : Nat) (verifier : Nat → Bool → Row)
    (input : List Bool) (certificate suffix : Nat) (hn : 0 < n) (hv : Closed n verifier)
    (htag : certificate%4 ≠ 0) :
    ∀ clock, Source284Relative.accepts (description k n verifier)
      (encodeFrame input suffix) certificate clock = false := by
  apply rejected_certificate_never_accepts k n verifier input certificate suffix hn hv
  simp [Source284TaggedWitnessCodec.decode,htag]

theorem overlong_witness_never_accepts (k n : Nat) (verifier : Nat → Bool → Row)
    (input witness : List Bool) (suffix witnessSuffix : Nat) (hn : 0 < n) (hv : Closed n verifier)
    (hover : bound k input.length < witness.length) :
    ∀ clock, Source284Relative.accepts (description k n verifier)
      (encodeFrame input suffix) (4*encodeFrame witness witnessSuffix) clock = false := by
  apply rejected_certificate_never_accepts k n verifier input _ suffix hn hv
  exact (Source284PreparedCutoff.tagged_decode_none_iff (bound k input.length) witness witnessSuffix).2 hover

/-- An in-bound certificate reaches the supplied finite verifier with the
exact decoded witness and retained input-side data. The subsequent run is
matched for every clock, with the state relocation explicitly paid. -/
theorem decoded_verifier_exact (k n : Nat) (verifier : Nat → Bool → Row)
    (input witness : List Bool) (certificate suffix : Nat) (hn : 0 < n) (hv : Closed n verifier)
    (hdec : Source284TaggedWitnessCodec.decode (bound k input.length) certificate = some witness) :
    ∃ witnessSuffix, certificate = 4*encodeFrame witness witnessSuffix ∧
      ∀ fuel, Source284Relative.run (description k n verifier)
        (Source284Relative.initial (encodeFrame input suffix) certificate)
        (Source284GapUnarySource.totalCost k input+
          (4+(Source284PayloadSentinelPipeline.totalCost witness.length+
            (Source284OffsetMatch.compareCost witness.length+(1+fuel))))) =
      lift (707+317*k+212) (Source284Relative.run (encode n verifier 1)
        ⟨2*Source284PayloadMarkOne.zeros witness
            (Source284ScratchFlip.flipped [false] ((witnessSuffix/4)/4)),
          pairTape (Source284OffsetExactHandoff.boundTokens (bound k input.length) witness)
            (otherHalf k input suffix),active 0⟩ fuel) := by
  obtain ⟨witnessSuffix,hcert,hafter⟩ := Source284OffsetDecodedHandoff.decoded_verifier_exact
    n verifier (bound k input.length) certificate (otherHalf k input suffix) witness hn hv hdec
  refine ⟨witnessSuffix,hcert,?_⟩
  intro fuel
  rw [source_after k n verifier input certificate suffix _ hn hv,hafter fuel,
    Source284SourceRelocation.lift_add]

def verifierEntryCost (k : Nat) (input witness : List Bool) : Nat :=
  Source284GapUnarySource.totalCost k input+
    (4+(Source284PayloadSentinelPipeline.totalCost witness.length+
      (Source284OffsetMatch.compareCost witness.length+1)))

noncomputable def verifierEntryPolynomial (k : Nat) : Polynomial Nat :=
  let b := Source284RestoredPolynomialRunway.countPolynomial k+1
  Source284GapUnarySource.costPolynomial k+6*b*b+50*b+61

/-- The entire path from raw input to verifier entry has a fixed polynomial
source-transition bound for every successfully decoded certificate. -/
theorem verifier_entry_polynomial (k : Nat) (input witness : List Bool)
    (certificate : Nat)
    (hdec : Source284TaggedWitnessCodec.decode (bound k input.length) certificate = some witness) :
    verifierEntryCost k input witness ≤ (verifierEntryPolynomial k).eval input.length := by
  have hw := Source284TaggedWitnessCodec.decode_length (bound k input.length) certificate witness hdec
  have hb : witness.length ≤ Source284GapUnarySource.gap k input.length :=
    le_trans hw (Nat.div_le_self _ _)
  have hsquare := Nat.mul_self_le_mul_self hb
  have hinit := Source284GapUnarySource.cost_polynomial k input
  unfold verifierEntryCost verifierEntryPolynomial
  rw [Source284PayloadSentinelPipeline.totalCost_formula]
  simp only [Source284OffsetMatch.compareCost,Polynomial.eval_add,Polynomial.eval_mul,
    Polynomial.eval_ofNat,Polynomial.eval_one,Source284RestoredPolynomialRunway.countPolynomial_eval]
  simp only [Source284GapUnarySource.gap] at hb hsquare
  nlinarith

/-- Every fixed polynomial witness requirement is met by one selected
finite initializer. The original verifier may still enforce a smaller
cutoff; this theorem does not enlarge that semantic cutoff. -/
theorem bound_dominates (p : Polynomial Nat) : ∃ k : Nat, ∀ n, p.eval n ≤ bound k n :=
  Source284GapUnarySource.bound_dominates p

/-- Enlarging the executable guard to the generated unary bound never loses
any witness admitted by the original polynomial cutoff. The verifier must
still reject witnesses between the two bounds when required by the language. -/
theorem original_witness_survives (p : Polynomial Nat) :
    ∃ k : Nat, ∀ (input : List Bool) (certificate : Nat) (witness : List Bool),
      Source284TaggedWitnessCodec.decode (p.eval input.length) certificate = some witness →
      Source284TaggedWitnessCodec.decode (bound k input.length) certificate = some witness := by
  obtain ⟨k,hk⟩ := bound_dominates p
  refine ⟨k,?_⟩
  intro input certificate witness hdec
  have hw := Source284TaggedWitnessCodec.decode_length (p.eval input.length) certificate witness hdec
  obtain ⟨suffix,hcert⟩ := Source284CertificateProbeSource.decoded_has_frame
    (p.eval input.length) certificate witness hdec
  rw [hcert]
  exact Source284OffsetDecodedHandoff.tagged_decode_frame (bound k input.length) witness suffix
    (le_trans hw (hk input.length))

namespace Fixtures
open Source284PreparedCutoff.Fixtures (acceptImmediately accept_closed)

/-- An invalid tag cannot use an immediately accepting continuation, even
on a zero-length source input and at an arbitrarily large clock. -/
example : ∀ clock, Source284Relative.accepts (description 0 1 acceptImmediately)
    (encodeFrame [] 0) 3 clock = false := by
  exact malformed_tag_never_accepts 0 1 acceptImmediately [] 3 0 (by decide)
    accept_closed (by decide)
end Fixtures

end Shared.Beeping.NPcoNP.Source284DynamicGuardSource
