open Shared.Beeping.NPcoNP.NativeHalfState28Exit
open Shared.Beeping.NPcoNP.NativeHalfState28Progress
set_option autoImplicit false
set_option maxRecDepth 32768
set_option maxHeartbeats 4000000

/-- The terminating 14/22 loop leaves a one under the state-23 head.
The arbitrary starting tape only needs a zero tail on the right. -/
theorem cycle_tail_marker (k : Nat) (h : Int) (tape : Int → Bool)
    (hz : ∀ p ≥ h+(k : Int), tape p=false) :
    ∃ (n : Nat) (e : Config 284), 0<n ∧ n≤2*k+2 ∧ e.state=23 ∧
      e.tape e.head=true ∧ silentSegment machine (cfg 14 h tape) e n := by
  induction k generalizing h tape with
  | zero =>
    have h0 : tape h=false := hz h (by simp)
    have h1 : tape (h+1)=false := hz (h+1) (by simp)
    exact ⟨2,cfg 23 h (setAt h tape),by omega,by omega,rfl,by simp [cfg,setAt],finish h tape h0 h1⟩
  | succ k ih =>
    cases h0 : tape h with
    | true =>
      have hz' : ∀ p ≥ (h+1)+(k : Int), tape p=false := by
        intro p hp
        apply hz p
        push_cast at *
        omega
      obtain ⟨n,e,hn,hbound,he,hmark,hseg⟩ := ih (h+1) tape hz'
      exact ⟨1+n,e,by omega,by omega,he,hmark,
        segAdd machine _ _ _ 1 n (oneSeg machine _ _ (step14_one h tape h0)) hseg⟩
    | false =>
      cases h1 : tape (h+1) with
      | false =>
        exact ⟨2,cfg 23 h (setAt h tape),by omega,by omega,rfl,by simp [cfg,setAt],finish h tape h0 h1⟩
      | true =>
        let tape' := clearAt (h+1) (setAt h tape)
        have hz' : ∀ p ≥ (h+2)+(k : Int), tape' p=false := by
          intro p hp
          have hp0 : p ≠ h := by omega
          have hp1 : p ≠ h+1 := by omega
          have hpz : tape p=false := by
            apply hz p
            push_cast at *
            omega
          simp [tape',clearAt,setAt,hp0,hp1,hpz]
        obtain ⟨n,e,hn,hbound,he,hmark,hseg⟩ := ih (h+2) tape' hz'
        exact ⟨2+n,e,by omega,by omega,he,hmark,
          segAdd machine _ _ _ 2 n (restart h tape h0 h1) hseg⟩

/-- Actual blank-start entries to 14 reach 23 with the needed marker. -/
theorem reachable_14_to_marked23 (time : Nat)
    (hstate : (machine.system.run time).state=14) :
    ∃ (n : Nat) (e : Config 284), 0<n ∧ e.state=23 ∧ e.tape e.head=true ∧
      silentSegment machine (machine.system.run time) e n := by
  obtain ⟨b,hb⟩ := run_has_right_zero time
  let h := (machine.system.run time).head
  let tape := (machine.system.run time).tape
  let k := (max b h-h).toNat
  have hk : b ≤ h+(k : Int) := by
    have hn : 0 ≤ max b h-h := by omega
    have he : (k : Int)=max b h-h := Int.toNat_of_nonneg hn
    omega
  have hz : ∀ p ≥ h+(k : Int), tape p=false := by
    intro p hp
    exact hb p (le_trans hk hp)
  obtain ⟨n,e,hn,_,he,hmark,hseg⟩ := cycle_tail_marker k h tape hz
  have hcfg : machine.system.run time = cfg 14 h tape := by
    cases hc : machine.system.run time with
    | mk state head cells =>
      simp only [hc,cfg] at hstate ⊢
      simp only [h,tape,hc,cfg] at *
      cases hstate
      rfl
  exact ⟨n,e,hn,he,hmark,by rw [hcfg]; exact hseg⟩

/-- The marker generated by the loop discharges the return scan's hypothesis. -/
theorem reachable_14_to_28 (time : Nat)
    (hstate : (machine.system.run time).state=14) :
    ∃ (n : Nat) (e : Config 284), 0<n ∧ e.state=28 ∧
      silentSegment machine (machine.system.run time) e n := by
  obtain ⟨n,c,hn,hc,hmark,hseg⟩ := reachable_14_to_marked23 time hstate
  have hrun : machine.system.run (time+n)=c := by
    rw [EventSystem.run_add, ← ScalarWordRefinement.advance_ofBeep]
    exact hseg.1
  have h23 : (machine.system.run (time+n)).state=23 := by rw [hrun]; exact hc
  have hm : (machine.system.run (time+n)).tape (machine.system.run (time+n)).head=true := by
    rw [hrun]
    exact hmark
  obtain ⟨m,e,hmp,he,hmore⟩ := reachable_marker_to_28 (time+n) h23
    (machine.system.run (time+n)).head (by rfl) hm
  refine ⟨n+m,e,by omega,he,?_⟩
  apply segAdd machine _ _ _ n m hseg
  rw [← hrun]
  exact hmore

/-- Every actual state-14 entry reaches state 97 after positive silent work.
This does not assert a marker on the left of the resulting state-97 head. -/
theorem reachable_14_to_97 (time : Nat)
    (hstate : (machine.system.run time).state=14) :
    ∃ (n : Nat) (e : Config 284), 0<n ∧ e.state=97 ∧
      silentSegment machine (machine.system.run time) e n := by
  obtain ⟨n,c,hn,hc,hseg⟩ := reachable_14_to_28 time hstate
  have hrun : machine.system.run (time+n)=c := by
    rw [EventSystem.run_add, ← ScalarWordRefinement.advance_ofBeep]
    exact hseg.1
  have h28 : (machine.system.run (time+n)).state=28 := by rw [hrun]; exact hc
  obtain ⟨m,e,hmp,he,hmore⟩ := reachable_28_to_97 (time+n) h28
  refine ⟨n+m,e,by omega,he,?_⟩
  apply segAdd machine _ _ _ n m hseg
  rw [← hrun]
  exact hmore

#print axioms cycle_tail_marker
#print axioms reachable_14_to_28
#print axioms reachable_14_to_97
end Shared.Beeping.NPcoNP.NativeIncMarkerProgress
