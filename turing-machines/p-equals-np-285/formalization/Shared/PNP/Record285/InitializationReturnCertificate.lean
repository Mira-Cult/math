import Shared.PNP.Record285.InitializationChecker
set_option maxRecDepth 16384
set_option maxHeartbeats 0
set_option exponentiation.threshold 4096
namespace Shared.PNP.Record285.InitializationReturnCertificate
open Shared.PNP.Record285.InitializationChecker Shared.PNP.Record285.PhysicalNumeric
open Shared.PNP.Record285.BootstrapSweep Shared.PNP.Record285.BootstrapRows
open Shared.PNP.Record285.BootstrapChecker (silent_compose)
def c0 : Config 285 := ⟨⟨76,by decide⟩,(-2:Int),,true,30⟩
def c1 : Config 285 := ⟨⟨51,by decide⟩,(2:Int),,true,5⟩
def c2 : Config 285 := ⟨⟨56,by decide⟩,(4:Int),,false,1⟩
def c3 : Config 285 := ⟨⟨112,by decide⟩,(-3824:Int),0,false,⟩
def c4 : Config 285 := ⟨⟨7,by decide⟩,(-4:Int),,true,320⟩
def c5 : Config 285 := ⟨⟨76,by decide⟩,(-2:Int),,false,80⟩
def b0 : List Command := [.single,.single,.rightRun .scan12 3,.single,.single,.single,.leftRun .scan51 0,.leftPair .scan51 0]
def b1 : List Command := [.leftRun .scan51 2,.single,.single,.leftRun .clear1 0,.single,.rightRun .scan55 2,.single,.rightRun .erase56 2]
def b2 : List Command := [.single,.single,.leftRun .scan119 5,.single,.leftRun .scan110 0,.leftPair .scan110 1907,.single,.single]
def b3 : List Command := [.single,.single,.single,.rightRun .scan109 5,.single,.single,.rightPair .boot6 1906,.single]
def b4 : List Command := [.single,.single]
theorem h0 : verify b0 c0 = some (12,c1) := by decide
theorem h1 : verify b1 c1 = some (14,c2) := by decide
theorem h2 : verify b2 c2 = some (3828,c3) := by decide
theorem h3 : verify b3 c3 = some (3826,c4) := by decide
theorem h4 : verify b4 c4 = some (2,c5) := by decide
theorem start_shape : c0 = ⟨exit,(-2:Int),rep4 1910,true,30⟩ := by decide
theorem end_shape : c5 = ⟨exit,(-2:Int),rep4 1910+1,false,80⟩ := by decide

/-- Exact event-free return to state 76. -/
theorem return_run : silent Record285.machine 7682 ⟨exit,(-2:Int),rep4 1910,true,30⟩ =
    some ⟨exit,(-2:Int),rep4 1910+1,false,80⟩ := by
  have step0 : silent Record285.machine 12 c0 = some c1 := verify_sound b0 c0 c1 12 h0
  have step1 : silent Record285.machine 14 c1 = some c2 := verify_sound b1 c1 c2 14 h1
  have step2 : silent Record285.machine 3828 c2 = some c3 := verify_sound b2 c2 c3 3828 h2
  have step3 : silent Record285.machine 3826 c3 = some c4 := verify_sound b3 c3 c4 3826 h3
  have step4 : silent Record285.machine 2 c4 = some c5 := verify_sound b4 c4 c5 2 h4
  have tail4 : silent Record285.machine 2 c4 = some c5 := step4
  have tail3 : silent Record285.machine 3828 c3 = some c5 := silent_compose _ c3 c4 c5 3826 2 step3 tail4
  have tail2 : silent Record285.machine 7656 c2 = some c5 := silent_compose _ c2 c3 c5 3828 3828 step2 tail3
  have tail1 : silent Record285.machine 7670 c1 = some c5 := silent_compose _ c1 c2 c5 14 7656 step1 tail2
  have tail0 : silent Record285.machine 7682 c0 = some c5 := silent_compose _ c0 c1 c5 12 7670 step0 tail1
  rw [← start_shape, ← end_shape]
  exact tail0

end Shared.PNP.Record285.InitializationReturnCertificate
