theorem first3750_valid : ∀ row ∈ first3750Rows, TargetRowValid row := by
  intro row h
  simp only [first3750Rows, List.mem_flatten] at h
  obtain ⟨batch, hbatch, hrow⟩ := h
  simp only [first3750Batches, List.mem_cons, List.not_mem_nil, or_false] at hbatch
