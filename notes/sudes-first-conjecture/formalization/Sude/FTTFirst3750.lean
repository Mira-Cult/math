theorem first3750_orders : first3750Rows.map TargetRow.order =
    (List.range 3750).map (fun i => 2001 + 2 * i) := by
  decide +kernel

/-- Exact coverage of all odd orders from 2001 through 9499. -/
theorem first3750_cover (n : ℕ) (hlo : 2001 ≤ n) (hhi : n ≤ 9499)
    (hodd : n % 2 = 1) :
    ∃ row ∈ first3750Rows, row.order = n ∧ TargetRowValid row := by
  have hmem : n ∈ first3750Rows.map TargetRow.order := by
    rw [first3750_orders]
    apply List.mem_map.mpr
    refine ⟨(n - 2001) / 2, ?_, ?_⟩
    · simp only [List.mem_range]
      omega
    · omega
  obtain ⟨row, hrow, hord⟩ := List.mem_map.mp hmem
  exact ⟨row, hrow, hord, first3750_valid row hrow⟩

